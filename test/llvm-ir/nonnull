#obj {
--name test
-Mroot=test.zig
#}

#write test.zig {
export fn entry(ptr: *i16) i16 {
    return ptr.*;
}
#}
#update "store"
#check llvm {
define #...@test.entry(ptr #...nonnull #...%0) #...{
#...load i16, ptr %0#...
}

#}

#write test.zig {
export fn entry(ptr: *i16) void {
    ptr.* = 42;
}
#}
#update "load"
#check llvm {
define #...@test.entry(ptr #...nonnull #...%0) #...{
#...store i16 42, ptr %0#...
}

#}
