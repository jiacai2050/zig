#obj {
--name test
-Mroot=test.zig
#}

#write test.zig {
export fn entry(ptr: *allowzero i16) i16 {
    return ptr.*;
}
#}
#update "load"
#check llvm {
define #...@test.entry(ptr #...%0) #...#0 #...{
#...load i16, ptr %0#...
}

#...
attributes #0 = {#... null_pointer_is_valid #...}
#}

#write test.zig {
export fn entry(ptr: *allowzero i16) void {
    ptr.* = 42;
}
#}
#update "store"
#check llvm {
define #...@test.entry(ptr #...%0) #...#0 #...{
#...store i16 42, ptr %0#...
}

#...
attributes #0 = {#... null_pointer_is_valid #...}
#}

#write test.zig {
export fn entry(ptr: *allowzero i16) i16 {
    return entry2(ptr[0..1]);
}
fn entry2(slice: []allowzero i16) i16 {
    @setRuntimeSafety(false);
    return slice[0];
}
#}
#update "slice load"
#check llvm {
define #...@test.entry2(#..., ptr #...%1, #...) #...#2 #...{
#...load i16, ptr %#...
}

#...
attributes #2 = {#... null_pointer_is_valid #...}
#}

#write test.zig {
export fn entry(ptr: *allowzero i16) void {
    entry2(ptr[0..1]);
}
fn entry2(slice: []allowzero i16) void {
    @setRuntimeSafety(false);
    slice[0] = 42;
}
#}
#update "slice store"
#check llvm {
define #...@test.entry2(#..., ptr #...%1, #...) #...#2 #...{
#...store i16 42, ptr %#...
}

#...
attributes #2 = {#... null_pointer_is_valid #...}
#}
