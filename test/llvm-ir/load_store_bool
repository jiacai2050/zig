#obj {
--name test
-Mroot=test.zig
#}

#write test.zig {
export fn foo(a: *bool, b: *align(2) bool) void {
    const tmp = a.*;
    a.* = b.*;
    b.* = tmp;
}
#}
#update
#check llvm {
define #...void @test.foo(ptr #...%0, ptr #...%1) #...{
#...
  %5 = load i8, ptr %0, align 1#...
  %6 = trunc nuw i8 %5 to i1#...
  %8 = load i8, ptr %1, align 2#...
  %9 = trunc nuw i8 %8 to i1#...
  %10 = zext i1 %9 to i8#...
  store i8 %10, ptr %0, align 1#...
  %11 = zext i1 %6 to i8#...
  store i8 %11, ptr %1, align 2#...
  ret void#...
}

#}
